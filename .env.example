# ==============================================================================
# Cyber Threat Intelligence (CTI) Platform Environment Configuration
# ==============================================================================

# Database Connection
# SQLite (default for instant zero-dependency local development):
DATABASE_URL=sqlite:///./cti_platform.db

# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cti_db

# Local file upload directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=26214400

# Transformer Model Checkpoint
# Use any Hugging Face token-classification checkpoint or a fine-tuned local CTI model
MODEL_CHECKPOINT=dslim/bert-base-NER
MODEL_LOCAL_DIR=./models/cti_transformer
USE_GPU=false
CONFIDENCE_THRESHOLD=0.50
